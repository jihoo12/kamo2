module Prelude

# Ordinary data, rather than kernel primitives. Applications can import this
# module explicitly; the library's compatibility entry point opens it by default.
data Bool : Type where {
  true : Bool;
  false : Bool
}

data Nat : Type where {
  zero : Nat;
  suc : Nat -> Nat
}

data Vec (A : Type) : Nat -> Type where {
  nil : Vec A zero;
  cons : (n : Nat) -> A -> Vec A n -> Vec A (suc n)
}
