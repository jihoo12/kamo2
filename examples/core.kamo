; Definitions are ordered. All arguments and universe levels are explicit.
(def id (Pi A (U 0) (Pi x A A)) (lam A (lam x x)))
(def not (Pi b Bool Bool)
  (lam b (bool-elim (lam _ Bool) false true b)))
(def not-true Bool (app not true))
(def not-false Bool (app not false))
(def two Nat (suc (suc zero)))
(def add (Pi m Nat (Pi n Nat Nat))
  (lam m (lam n (nat-elim (lam _ Nat) n (lam k (lam acc (suc acc))) m))))
(def four Nat (app (app add two) two))
(def dependent-pair (Sigma A (U 0) A) (pair Bool true))
(def unpack Bool (snd dependent-pair))
(def refl-true (Path i Bool true true) (path i true))
(def endpoint Bool (at refl-true 1))
(def transport-bool Bool (coe i Bool 0 1 true))
(def transport-function (Pi b Bool Bool)
  (coe i (Pi b Bool Bool) 0 1 not))
(def transport-pair (Sigma b Bool Bool)
  (coe i (Sigma b Bool Bool) 0 1 (pair true false)))
(def transport-path (Path i Bool true true)
  (coe j (Path i Bool true true) 0 1 refl-true))
(def composed Bool (com i Bool 0 1 true ((top true))))
(def split Bool (system Bool ((top true) (bottom false))))
