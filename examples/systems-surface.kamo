# A total compatible system: the top branch covers generic dimensions,
# while endpoint branches agree with the declared path boundaries.
def eta (A : Type) (x : A) (y : A) (p : x == y) : x == y =
  path i => system A {
    i = 0 => x;
    i = 1 => y;
    top => p @ i
  }

# A system may be partial globally when its enclosing tube restricts the face.
def localSystem (A : Type) (x : A) : x == x =
  path i => com (j => A) 0 0 x {
    i = 0 => system A { i = 0 => x }
  }

def refl : true == true = path i => true
def left : Bool = (eta Bool true true refl) @ 0
def right : Bool = (eta Bool true true refl) @ 1
